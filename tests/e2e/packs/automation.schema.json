{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/testing/automation.schema.json",
  "title": "Offline automation pack (metaviewer.automation/v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "mode",
    "start",
    "steps",
    "budget",
    "expect",
    "fixtures"
  ],
  "properties": {
    "schema": {
      "const": "metaviewer.automation/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "mode": {
      "type": "string",
      "const": "offline"
    },
    "start": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(click:[^\\r\\n]+|type:[^\\r\\n]+|key:[A-Za-z0-9_-]+(\\+[A-Za-z0-9_-]+)*|scroll:(up|down|left|right)|read:[^\\r\\n]+)$"
      }
    },
    "budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "expect": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "fixtures": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    },
    "report_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "col",
        "index"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
