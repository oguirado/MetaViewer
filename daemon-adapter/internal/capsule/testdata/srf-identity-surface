#!/usr/bin/env python3
import json
import os
import sys
import time

verb = sys.argv[1]
if "SRF_IDENTITY_STORE_ROOT" in os.environ:
    with open(os.path.join(os.environ["SRF_IDENTITY_STORE_ROOT"], "cli-calls.jsonl"), "a") as log:
        log.write(json.dumps({"argv": sys.argv[1:], "env": {k: v for k, v in os.environ.items() if k in ("SRF_IDENTITY_STORE_ROOT", "SRF_PROXY_REGISTRY", "MV_SRF_STATE_DIR")}}) + "\n")
if verb == "start":
    print(json.dumps({"container": "srf-id-demo", "run_id": "demo-run", "windows": [{"id": "w1", "x": 0, "y": 0, "w": 2, "h": 1, "title": "", "url": ""}]}))
elif verb == "frame":
    root = os.environ["SRF_IDENTITY_STORE_ROOT"]
    print(json.dumps({"path": root + "/demo-run/frames/w1/f.png", "seq": 1,
                      "sha256_rgb24": __import__("hashlib").sha256(bytes([255, 0, 0, 0, 255, 0])).hexdigest(),
                      "width": 2, "height": 1, "capture_mono_ns": 200,
                      "generation": "srf-id-demo",
                      "window": {"id": "w1", "x": 0, "y": 0, "w": 2, "h": 1, "title": "", "url": ""}}))
elif verb == "input":
    print(json.dumps({"surface_id": "w1", "kind": "click", "input_mono_ns": 200,
                      "focus_verified": True, "result": "ok"}))
elif verb == "stop":
    print(json.dumps({"stopped": "srf-id-demo", "removed_verified": True}))
elif verb in ("capabilities", "observe", "probe"):
    print(json.dumps({"argv": sys.argv[1:], "env": {k: v for k, v in os.environ.items() if k in ("SRF_IDENTITY_STORE_ROOT", "SRF_PROXY_REGISTRY", "MV_SRF_STATE_DIR")}}))
elif verb == "overflow":
    print("x" * 65536)
elif verb == "delay":
    time.sleep(5)
elif verb == "environment":
    print(json.dumps({"clean": "UNADMITTED_TEST_SECRET" not in os.environ}))
else:
    sys.exit(6)
