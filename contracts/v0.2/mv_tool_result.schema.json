{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.2/mv_tool_result.schema.json",
  "title": "MV Tool Result",
  "description": "Core to agent/CLI outcome for one mv_tool_call. request_id echoes the call envelope msg_id. All *_ns fields (frame.ts_ns, receipt.executed_at_ns, input_mono_ns) are session-relative monotonic nanoseconds since core/capsule start; never wall-clock UNIX epoch ns. Bounded by 2^53 - 1 (9007199254740991, ~104.25 days); at the ceiling the core fails closed (refuses new work with a logged typed error) so the session must be restarted (never re-origined).",
  "$defs": {
    "bbox": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    "frame": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "frame_ref/v0.2",
          "minLength": 14,
          "maxLength": 14
        },
        "surface_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ts_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "format": {
          "const": "rgb24",
          "minLength": 5,
          "maxLength": 5
        },
        "ramws_path": {
          "type": "string",
          "minLength": 10,
          "maxLength": 255,
          "pattern": "^/dev/shm(/[A-Za-z0-9_][A-Za-z0-9._-]{0,127}){1,8}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema",
        "surface_id",
        "generation",
        "tick",
        "ts_ns",
        "width",
        "height",
        "format",
        "ramws_path",
        "sha256",
        "capture_us"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    "observation": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "observation/v0.2",
          "minLength": 16,
          "maxLength": 16
        },
        "frame_ref": {
          "$ref": "#/$defs/frame"
        },
        "vision": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            },
            "changed_regions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/bbox"
              },
              "minItems": 0,
              "maxItems": 256
            },
            "elements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "bbox": {
                    "$ref": "#/$defs/bbox"
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "name": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 4096
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "bbox",
                  "role",
                  "name",
                  "confidence"
                ],
                "additionalProperties": false,
                "maxProperties": 256
              },
              "minItems": 0,
              "maxItems": 256
            }
          },
          "required": [
            "summary",
            "changed_regions",
            "elements"
          ],
          "additionalProperties": false,
          "maxProperties": 256
        },
        "ground_truth": {
          "type": "object",
          "properties": {
            "source": {
              "const": "holdings_lane",
              "minLength": 13,
              "maxLength": 13
            },
            "state_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "source",
            "state_sha256",
            "tick"
          ],
          "additionalProperties": false,
          "maxProperties": 256
        }
      },
      "required": [
        "schema",
        "frame_ref"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    "surface": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "surface/v0.2",
          "minLength": 12,
          "maxLength": 12
        },
        "surface_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15,
          "enum": [
            "desktop_capsule",
            "browser",
            "game_capsule",
            "vm"
          ]
        },
        "display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "geometry": {
          "type": "object",
          "properties": {
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            }
          },
          "required": [
            "w",
            "h"
          ],
          "additionalProperties": false,
          "maxProperties": 256
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 9,
          "enum": [
            "active",
            "standby",
            "ceded",
            "destroyed",
            "lost"
          ]
        },
        "visibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "enum": [
            "folded",
            "unfolded",
            "pinned"
          ]
        },
        "control": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "enum": [
            "agent",
            "human",
            "shared"
          ]
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "schema",
        "surface_id",
        "kind",
        "display",
        "geometry",
        "state",
        "visibility",
        "control",
        "profile_id"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    "verdict_admitted": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "action_verdict/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "decision": {
          "const": "admitted",
          "minLength": 8,
          "maxLength": 8
        },
        "core_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema",
        "proposal_id",
        "decision",
        "core_seq"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    "receipt_verified": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "action_receipt/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "executed_at_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "after_frame": {
          "$ref": "#/$defs/frame"
        },
        "verified": {
          "const": true
        },
        "verification": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12,
              "enum": [
                "pixel",
                "element",
                "state_sha256"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "method",
            "detail"
          ],
          "additionalProperties": false,
          "maxProperties": 256
        },
        "error": {
          "const": "",
          "minLength": 0,
          "maxLength": 0
        }
      },
      "required": [
        "schema",
        "proposal_id",
        "executed_at_ns",
        "after_frame",
        "verified",
        "verification",
        "error"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mv_tool_result/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "op": {
          "const": "observe",
          "minLength": 7,
          "maxLength": 7
        },
        "status": {
          "const": "ok",
          "minLength": 2,
          "maxLength": 2
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "schema",
        "request_id",
        "op",
        "status",
        "observation"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mv_tool_result/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "op": {
          "const": "list",
          "minLength": 4,
          "maxLength": 4
        },
        "status": {
          "const": "ok",
          "minLength": 2,
          "maxLength": 2
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "request_id",
        "op",
        "status",
        "surfaces",
        "next_cursor"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mv_tool_result/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "op": {
          "const": "propose",
          "minLength": 7,
          "maxLength": 7
        },
        "status": {
          "const": "admitted",
          "minLength": 8,
          "maxLength": 8
        },
        "verdict": {
          "$ref": "#/$defs/verdict_admitted"
        }
      },
      "required": [
        "schema",
        "request_id",
        "op",
        "status",
        "verdict"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mv_tool_result/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "op": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11,
          "enum": [
            "observe",
            "list",
            "propose",
            "wait_verify"
          ]
        },
        "status": {
          "const": "refused",
          "minLength": 7,
          "maxLength": 7
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 28,
          "enum": [
            "STALE_FRAME",
            "SURFACE_NOT_AGENT_CONTROLLED",
            "LOCKED_BY_OTHER",
            "BUDGET_EXCEEDED",
            "OUT_OF_BOUNDS",
            "POLICY"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        }
      },
      "required": [
        "schema",
        "request_id",
        "op",
        "status",
        "reason_code",
        "detail"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mv_tool_result/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "op": {
          "const": "wait_verify",
          "minLength": 11,
          "maxLength": 11
        },
        "status": {
          "const": "pending",
          "minLength": 7,
          "maxLength": 7
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "required": [
        "schema",
        "request_id",
        "op",
        "status",
        "proposal_id",
        "retry_after_ms"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mv_tool_result/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "op": {
          "const": "wait_verify",
          "minLength": 11,
          "maxLength": 11
        },
        "status": {
          "const": "verified",
          "minLength": 8,
          "maxLength": 8
        },
        "receipt": {
          "$ref": "#/$defs/receipt_verified"
        },
        "focus_verified": {
          "const": true
        },
        "input_mono_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "frame_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "request_id",
        "op",
        "status",
        "receipt",
        "focus_verified",
        "input_mono_ns",
        "frame_sha256"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mv_tool_result/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "op": {
          "const": "wait_verify",
          "minLength": 11,
          "maxLength": 11
        },
        "status": {
          "const": "timeout",
          "minLength": 7,
          "maxLength": 7
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "verified": {
          "const": false
        }
      },
      "required": [
        "schema",
        "request_id",
        "op",
        "status",
        "proposal_id",
        "verified"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mv_tool_result/v0.2",
          "minLength": 19,
          "maxLength": 19
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "op": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11,
          "enum": [
            "observe",
            "list",
            "propose",
            "wait_verify"
          ]
        },
        "status": {
          "const": "error",
          "minLength": 5,
          "maxLength": 5
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "enum": [
            "PROTOCOL",
            "UNAVAILABLE",
            "NOT_FOUND",
            "VERIFICATION_FAILED"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        }
      },
      "required": [
        "schema",
        "request_id",
        "op",
        "status",
        "code",
        "detail"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    }
  ]
}
