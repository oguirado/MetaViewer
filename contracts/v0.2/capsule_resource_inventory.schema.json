      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "string",
      "minLength": 2,
      "maxLength": 65536
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema": {
      "const": "capsule_resource_inventory/v0.2"
    }
  },
  "required": [
    "seq",
    "prev",
    "payload",
    "sha256",
    "schema"
  ],
