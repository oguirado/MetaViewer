{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.2/surface_input.schema.json",
  "title": "Surface Input",
  "description": "Renderer-to-host human keyboard and pointer input batch for an operator-controlled capsule surface.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 256,
  "required": [
    "schema",
    "surface_id",
    "stream_id",
    "seq",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "surface_input/v0.2"
    },
    "surface_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "stream_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/click_event" },
          { "$ref": "#/$defs/key_event" },
          { "$ref": "#/$defs/type_event" },
          { "$ref": "#/$defs/scroll_event" }
        ]
      }
    }
  },
  "$defs": {
    "click_event": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 256,
      "required": ["kind", "x", "y", "button"],
      "properties": {
        "kind": {
          "const": "click"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "button": {
          "type": "string",
          "enum": ["left", "middle", "right"],
          "maxLength": 65536
        }
      }
    },
    "key_event": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 256,
      "required": ["kind", "keys"],
      "properties": {
        "kind": {
          "const": "key"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9_+]{1,32}$"
          }
        }
      }
    },
    "type_event": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 256,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "const": "type"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000]{1,1024}$"
        }
      }
    },
    "scroll_event": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 256,
      "required": ["kind", "dx", "dy", "x", "y"],
      "properties": {
        "kind": {
          "const": "scroll"
        },
        "dx": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "dy": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    }
  }
}
