{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.2/guest_command_session.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "guest_command_session/v0.2"
    },
    "workload_id": {
      "type": "string",
      "pattern": "^workload-[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 73
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "owner_id": {
      "type": "string",
      "pattern": "^actor-[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 70
    },
    "profile_id": {
      "const": "guest-command-arm64-v1"
    },
    "backend": {
      "const": "firecracker"
    },
    "isa": {
      "const": "aarch64"
    },
    "phase": {
      "type": "string",
      "enum": [
        "starting",
        "ready",
        "running",
        "cancelling",
        "awaiting_control",
        "stopping",
        "uncertain",
        "stopped"
      ]
    },
    "ownership": {
      "type": "string",
      "enum": [
        "held",
        "released"
      ]
    },
    "jobs_started": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "job": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "pattern": "^job-[a-z0-9][a-z0-9._-]{0,63}$",
              "maxLength": 68
            },
            "state": {
              "type": "string",
              "enum": [
                "running",
                "cancelling",
                "exited",
                "cancelled",
                "timed_out",
                "output_limit",
                "unknown"
              ]
            },
            "exit_code": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                {
                  "type": "null"
                }
              ]
            },
            "signal": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "stdout_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "stderr_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "output_complete": {
              "type": "boolean"
            }
          },
          "required": [
            "job_id",
            "state",
            "exit_code",
            "signal",
            "stdout_bytes",
            "stderr_bytes",
            "output_complete"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "controls": {
      "type": "object",
      "properties": {
        "cancel": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "string",
                  "pattern": "^request-[a-z0-9][a-z0-9._-]{0,63}$",
                  "maxLength": 72
                },
                "ack": {
                  "enum": [
                    "pending",
                    "accepted",
                    "refused"
                  ]
                }
              },
              "required": [
                "request_id",
                "ack"
              ],
              "additionalProperties": false
            }
          ]
        },
        "stop": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "string",
                  "pattern": "^request-[a-z0-9][a-z0-9._-]{0,63}$",
                  "maxLength": 72
                },
                "ack": {
                  "enum": [
                    "pending",
                    "accepted",
                    "refused"
                  ]
                }
              },
              "required": [
                "request_id",
                "ack"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "cancel",
        "stop"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "workload_id",
    "generation",
    "owner_id",
    "profile_id",
    "backend",
    "isa",
    "phase",
    "ownership",
    "jobs_started",
    "job",
    "controls"
  ],
  "additionalProperties": false,
  "title": "guest_command_session"
}
