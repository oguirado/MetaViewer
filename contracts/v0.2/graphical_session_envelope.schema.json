{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.2/graphical_session_envelope.schema.json",
  "title": "Graphical QEMU session envelope",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "graphical_session_envelope/v0.2",
      "maxLength": 31
    },
    "msg_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "from": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "ui",
            "core",
            "daemon"
          ],
          "maxLength": 6
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "component",
        "instance"
      ],
      "additionalProperties": false,
      "maxProperties": 2
    },
    "to": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "ui",
            "core",
            "daemon"
          ],
          "maxLength": 6
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "component",
        "instance"
      ],
      "additionalProperties": false,
      "maxProperties": 2
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "body": {
      "oneOf": [
        {
          "$ref": "graphical_session_request.schema.json"
        },
        {
          "$ref": "graphical_session_event.schema.json"
        }
      ]
    }
  },
  "required": [
    "schema",
    "msg_id",
    "ts_ns",
    "from",
    "to",
    "session_id",
    "seq",
    "nonce",
    "body"
  ],
  "additionalProperties": false,
  "maxProperties": 9
}
