{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.2/capsule_meta.schema.json",
  "title": "Capsule Meta",
  "description": "Normalized capsule metadata from the daemon adapter; paths and sockets come from capsule metadata, never guessed.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "capsule_meta/v0.2"
    },
    "surface_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "browser",
        "program",
        "desktop_capsule",
        "game_capsule",
        "vm"
      ],
      "maxLength": 65536
    },
    "container": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "display": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fb_path": {
      "description": "Shared-memory framebuffer path under /dev/shm with 1..8 segments ([A-Za-z0-9_][A-Za-z0-9._-]{0,127}), without '.', '..', hidden names, empty segments, NUL, or \r\n.",
      "type": "string",
      "minLength": 10,
      "maxLength": 255,
      "pattern": "^/dev/shm(/[A-Za-z0-9_][A-Za-z0-9._-]{0,127}){1,8}$"
    },
    "lane_socket": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000\\r\\n]*$"
    },
    "ready_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "window_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "x_px": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16383
          },
          "y_px": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16383
          },
          "width_px": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "height_px": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          }
        },
        "required": [
          "window_id",
          "x_px",
          "y_px",
          "width_px",
          "height_px"
        ],
        "additionalProperties": false,
        "maxProperties": 256
      }
    }
  },
  "required": [
    "schema",
    "surface_id",
    "kind",
    "container",
    "run_id",
    "display",
    "fb_path",
    "ready_line",
    "windows"
  ],
  "additionalProperties": false,
  "maxProperties": 256
}
