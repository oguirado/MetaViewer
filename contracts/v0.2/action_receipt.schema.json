{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.2/action_receipt.schema.json",
  "title": "Action Receipt",
  "type": "object",
  "properties": {
    "schema": {
      "const": "action_receipt/v0.2"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "executed_at_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "after_frame": {
      "$ref": "frame_ref.schema.json"
    },
    "verified": {
      "type": "boolean"
    },
    "verification": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "pixel",
            "element",
            "state_sha256"
          ],
          "maxLength": 65536
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "method",
        "detail"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    "error": {
      "type": "string",
      "maxLength": 65536
    },
    "native_evidence": {
      "description": "Checked native input result, bound to the public surface. input_ts_ns is input_mono_ns minus the hello monotonic origin. Focus fields are absent when the native component does not supply them. Presence alone never proves an action expectation.",
      "type": "object",
      "properties": {
        "surface_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "native_surface_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "click",
            "key",
            "text"
          ],
          "maxLength": 128
        },
        "input_mono_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_ts_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "focus_verified": {
          "type": "boolean"
        },
        "result": {
          "type": "string",
          "enum": [
            "ok"
          ],
          "maxLength": 128
        }
      },
      "required": [
        "surface_id",
        "input_mono_ns",
        "input_ts_ns"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    }
  },
  "required": [
    "schema",
    "proposal_id",
    "executed_at_ns",
    "after_frame",
    "verified",
    "verification",
    "error"
  ],
  "additionalProperties": false,
  "maxProperties": 256
}
