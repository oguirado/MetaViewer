{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.2/session_record.schema.json",
  "title": "Session Record",
  "description": "Session journal record. Timestamps in associated session events are session-relative monotonic nanoseconds since core/capsule start; never wall-clock UNIX epoch ns. Bounded by 2^53 - 1 (~104.25 days); at the ceiling the core fails closed (refuses new work with a logged typed error) so the session must be restarted (never re-origined).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "session_record/v0.2"
    },
    "core_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "received",
        "admitted",
        "refused",
        "executed",
        "verified",
        "surface_changed"
      ],
      "maxLength": 65536
    },
    "msg_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "prev_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 65536
    }
  },
  "required": [
    "schema",
    "core_seq",
    "kind",
    "msg_id",
    "prev_sha256"
  ],
  "additionalProperties": false,
  "maxProperties": 256
}
