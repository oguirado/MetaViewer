{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.2/frame_ref.schema.json",
  "title": "Frame Ref",
  "type": "object",
  "properties": {
    "schema": {
      "const": "frame_ref/v0.2",
      "minLength": 14,
      "maxLength": 14
    },
    "surface_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ts_ns": {
      "description": "Session-relative monotonic nanoseconds since core/capsule start; never wall-clock UNIX epoch ns. Bounded by 2^53 - 1 (~104.25 days); at the ceiling the core fails closed (refuses new work with a logged typed error) so the session must be restarted (never re-origined).",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "format": {
      "const": "rgb24",
      "minLength": 5,
      "maxLength": 5
    },
    "ramws_path": {
      "description": "Shared-memory path under /dev/shm with 1..8 segments ([A-Za-z0-9_][A-Za-z0-9._-]{0,127}), without '.', '..', hidden names, empty segments, NUL, or \r\n.",
      "type": "string",
      "minLength": 10,
      "maxLength": 255,
      "pattern": "^/dev/shm(/[A-Za-z0-9_][A-Za-z0-9._-]{0,127}){1,8}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema",
    "surface_id",
    "generation",
    "tick",
    "ts_ns",
    "width",
    "height",
    "format",
    "ramws_path",
    "sha256",
    "capture_us"
  ],
  "additionalProperties": false,
  "maxProperties": 256
}
