{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.2/guest_command_observation.schema.json",
  "title": "Proposed accepted guest command observation",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "guest_command_observation/v0.2",
      "maxLength": 30
    },
    "event_id": {
      "type": "string",
      "pattern": "^event-[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 70
    },
    "event": {
      "type": "string",
      "const": "accepted_run",
      "maxLength": 12
    },
    "accepted_event_id": {
      "type": "string",
      "pattern": "^event-[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 70
    },
    "request_id": {
      "type": "string",
      "pattern": "^request-[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 72
    },
    "reservation_id": {
      "type": "string",
      "pattern": "^reservation-[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 76
    },
    "owner_id": {
      "type": "string",
      "pattern": "^actor-[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 70
    },
    "workload_id": {
      "type": "string",
      "pattern": "^workload-[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 73
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "job_id": {
      "type": "string",
      "pattern": "^job-[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 68
    },
    "requester": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "ui",
            "agent"
          ],
          "maxLength": 5
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "component",
        "instance"
      ],
      "additionalProperties": false,
      "maxProperties": 2
    },
    "command_utf8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "cwd": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    }
  },
  "required": [
    "schema",
    "event_id",
    "event",
    "accepted_event_id",
    "request_id",
    "reservation_id",
    "owner_id",
    "workload_id",
    "generation",
    "job_id",
    "requester",
    "command_utf8",
    "cwd",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "maxProperties": 14
}
