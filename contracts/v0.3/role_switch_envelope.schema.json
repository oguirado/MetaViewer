{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaviewer.local/contracts/v0.3/role_switch_envelope.schema.json",
  "title": "Envelope",
  "type": "object",
  "properties": {
    "schema": {
      "const": "role_switch_envelope/v0.3"
    },
    "msg_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts_ns": {
      "description": "Session-relative monotonic nanoseconds since core/capsule start; never wall-clock UNIX epoch ns. Bounded by 2^53 - 1 (9007199254740991, ~104.25 days); at the ceiling the core fails closed (refuses new work with a logged typed error) so the session must be restarted (never re-origined).",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "from": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "core",
            "ui",
            "daemon",
            "agent",
            "vision",
            "wender"
          ],
          "maxLength": 65536
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "component",
        "instance"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    "to": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "core",
            "ui",
            "daemon",
            "agent",
            "vision",
            "wender"
          ],
          "maxLength": 65536
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "component",
        "instance"
      ],
      "additionalProperties": false,
      "maxProperties": 256
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "body": {
      "oneOf": [
        {
          "$ref": "role_switch.schema.json"
        },
        {
          "$ref": "role_switch_result.schema.json"
        }
      ]
    }
  },
  "required": [
    "schema",
    "msg_id",
    "ts_ns",
    "from",
    "to",
    "session_id",
    "seq",
    "nonce",
    "body"
  ],
  "additionalProperties": false,
  "maxProperties": 256
}
