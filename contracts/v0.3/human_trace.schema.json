{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metaviewer:human_trace:v0.3",
  "title": "MetaViewer human input trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session_id", "surface_id", "capsule_id", "seq", "monotonic_ns", "kind", "coords", "viewport", "ax_row", "details"],
  "properties": {
    "schema": { "const": "metaviewer.human_trace/v0.3" },
    "session_id": { "$ref": "#/$defs/id" },
    "surface_id": { "$ref": "#/$defs/id" },
    "capsule_id": { "$ref": "#/$defs/id" },
    "seq": { "type": "integer", "minimum": 1 },
    "monotonic_ns": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "kind": { "enum": ["click", "move", "key", "scroll"] },
    "coords": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/coordinates" } ] },
    "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
    "ax_row": { "type": ["integer", "null"], "minimum": 0 },
    "details": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,128}$" },
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 } } },
    "coordinates": { "type": "object", "additionalProperties": false, "required": ["tile", "capsule"], "properties": { "tile": { "$ref": "#/$defs/point" }, "capsule": { "$ref": "#/$defs/point" } } },
    "key": { "type": "object", "additionalProperties": false, "required": ["phase", "key", "redacted"], "properties": { "phase": { "enum": ["up", "down"] }, "key": { "enum": [null, "Enter", "Tab", "Escape", "Backspace", "Delete", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End", "PageUp", "PageDown", "Shift", "Control", "Alt", "Meta", "CapsLock"] }, "redacted": { "type": "boolean" } }, "allOf": [ { "if": { "properties": { "redacted": { "const": true } } }, "then": { "properties": { "key": { "type": "null" } } } } ] },
    "scroll": { "type": "object", "additionalProperties": false, "required": ["dx", "dy", "delta_mode"], "properties": { "dx": { "type": "number" }, "dy": { "type": "number" }, "delta_mode": { "enum": [0, 1, 2] } } },
    "click": { "type": "object", "additionalProperties": false, "required": ["button"], "properties": { "button": { "enum": [0, 1, 2] } } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "key" } } }, "then": { "properties": { "coords": { "type": "null" }, "details": { "$ref": "#/$defs/key" } } }, "else": { "properties": { "coords": { "$ref": "#/$defs/coordinates" } } } },
    { "if": { "properties": { "kind": { "const": "click" } } }, "then": { "properties": { "details": { "$ref": "#/$defs/click" } } } },
    { "if": { "properties": { "kind": { "const": "scroll" } } }, "then": { "properties": { "details": { "$ref": "#/$defs/scroll" } } } },
    { "if": { "properties": { "kind": { "const": "move" } } }, "then": { "properties": { "details": { "type": "object", "additionalProperties": false } } } }
  ]
}
