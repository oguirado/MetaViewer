{
  "schema": "metaviewer.design-tokens/v1",
  "authority": {
    "owner": "ui/src/design/metaviewer.tokens.json",
    "direction": "primitive -> semantic -> component",
    "vendorVariableReferenceAllowed": false,
    "deterministicOfflineGeneration": true,
    "cssVariablePrefix": "--mv"
  },
  "axes": {
    "scheme": {
      "preferences": [
        "system",
        "light",
        "dark"
      ],
      "resolvedModes": [
        "light",
        "dark"
      ],
      "defaultPreference": "light",
      "rootAttribute": "data-theme-scheme"
    },
    "contrast": {
      "values": [
        "normal",
        "high"
      ],
      "default": "normal",
      "rootAttribute": "data-theme-contrast"
    },
    "density": {
      "values": [
        "compact",
        "regular",
        "comfortable"
      ],
      "default": "regular",
      "rootAttribute": "data-theme-density"
    },
    "textScale": {
      "values": [
        "0.875",
        "1",
        "1.125",
        "1.25"
      ],
      "default": "1",
      "independentOfDensity": true,
      "rootAttribute": "data-theme-text-scale"
    },
    "forcedColors": {
      "values": [
        "none",
        "active"
      ],
      "default": "none",
      "mediaQuery": "(forced-colors: active)",
      "rootAttribute": "data-theme-forced-colors"
    },
    "reducedMotion": {
      "values": [
        "no-preference",
        "reduce"
      ],
      "default": "no-preference",
      "mediaQuery": "(prefers-reduced-motion: reduce)",
      "rootAttribute": "data-theme-motion"
    }
  },
